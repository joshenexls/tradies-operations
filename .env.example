# Everything runs offline by default (PGlite + fixtures + FixtureLLM).
# Add keys as they arrive — no code changes needed.

# ── Stage A (ops desk + Supabase + real Claude) ──────────────────────────────
# DATABASE_URL=                    # Supabase Postgres. Migrations need the
#                                  # SESSION-mode string (port 5432): DATABASE_URL=... pnpm --filter @tradies/db db:migrate
# SITE_GENERATOR=fixture           # fixture | anthropic
# ANTHROPIC_API_KEY=               # Anthropic Console (required when SITE_GENERATOR=anthropic)
# ANTHROPIC_MODEL=claude-sonnet-5
# LLM_RATE_INPUT_MICROGBP=2.4      # micro-GBP per input token (Sonnet 5 ≈ $3/MTok @ ~£0.79/USD)
# LLM_RATE_OUTPUT_MICROGBP=12
# OPS_AUTH_USER=ops                # ops desk Basic auth — MUST be set in prod
# OPS_AUTH_PASS=
# PREVIEW_URL_PATTERN=http://{slug}.localhost:3000   # prod: https://{slug}.app.tradies.co.uk
# LANGFUSE_PUBLIC_KEY=             # optional tracing
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=

# ── Stage B (orchestration + discovery) ──────────────────────────────────────
# TRIGGER_SECRET_KEY=              # Trigger.dev Cloud
# TRIGGER_PROJECT_ID=
# INTEGRATIONS=fixture             # fixture | real
# APIFY_TOKEN=                     # Apify console (Google Maps scraper actor)
# APIFY_ACTOR_ID=compass~crawler-google-places
# APIFY_COST_PER_PLACE_MICROGBP=2400
# FIRECRAWL_API_KEY=
# PAGESPEED_API_KEY=               # optional — PSI is keyless at low volume
# JUDGE_MODEL=claude-haiku-4-5
# JUDGE_RATE_INPUT_MICROGBP=0.8
# JUDGE_RATE_OUTPUT_MICROGBP=4
# OUTREACH_DRY_RUN=1               # keep 1 until Phase 5 (Smartlead)
# RENDER_QA_DIR=.qa-artifacts
# PREVIEW_TTL_DAYS=30

# ── HTML design systems (library upload + generation) ───────────────────────
# TEMPLATE_INGESTOR=fixture        # fixture | anthropic (annotates uploaded landers with Claude)
# TEMPLATE_MAX_UPLOAD_KB=512

# ── Chatbot (lean version — answers only from the facts sheet) ──────────────
# CHAT_RESPONDER=fixture           # fixture | anthropic
# CHAT_MODEL=claude-haiku-4-5
# CHAT_RATE_PER_SESSION=20         # messages per session/IP per window
# CHAT_RATE_PER_SITE=200           # messages per site per window
# CHAT_RATE_WINDOW_SEC=3600
# CHAT_WIDGET=1                    # 0 hides the widget (visual tests pin this)

# ── Hosting (Cloudflare — see docs/deploy-cloudflare.md) ─────────────────────
# IMAGE_POOL_SOURCE=svg            # svg (deterministic trade-tuned placeholder art) | r2 (real photography)
# POOL_BASE_URL=                   # e.g. https://pools.tradies.co.uk (required for r2)
# PEXELS_API_KEY=                  # scripts/curate-pool.ts imagery curation → upload to R2, then set IMAGE_POOL_SOURCE=r2
# PREVIEW_VISIT_SALT=              # salts hashed visitor ids in preview_visits — set in prod

# ── Phase 5 outreach (fixtures + dry-run by default) ─────────────────────────
# PITCH_GENERATOR=fixture          # fixture | anthropic
# SMARTLEAD_API_KEY=               # presence switches the real Smartlead client on
# SMARTLEAD_WEBHOOK_SECRET=        # shared secret on the webhook URL
# SMARTLEAD_COST_PER_SEND_MICROGBP=800
# OUTREACH_SENDING_DOMAIN=mail.tradies.co.uk
# RESEND_API_KEY=                  # inbox sending + inbound replies
# RESEND_WEBHOOK_SECRET=           # Resend signing secret (svix format)
# INBOX_FROM_EMAIL=                # composer From; inbound uses replies+prospect-{id}@<inbound domain>
# RAW_MAIL_DIR=.raw-mail
# UNSUBSCRIBE_SECRET=              # HMAC for /u/[token] one-click unsubscribe — MUST set in prod
# UNSUBSCRIBE_BASE_URL=            # e.g. https://outreach.tradies.co.uk
# PRIVACY_NOTICE_URL=
# OPERATOR_COMPANY_NUMBER=         # legal footer (built in code, never LLM)
# OPERATOR_REGISTERED_OFFICE=
# PRICE_LINE=                      # e.g. "£19.99/mo — setup fee waived with code WELCOME"

# ── Round 4: conversion (claim → Stripe → live → portal) ────────────────────
# STRIPE_SECRET_KEY=               # presence switches the real Stripe client on
# STRIPE_WEBHOOK_SECRET=           # signing secret of the sites-app webhook endpoint
# STRIPE_PRICE_MONTHLY=            # £19.99/mo recurring price id
# STRIPE_PRICE_SETUP=              # £149.99 one-time price id (displayed, waived)
# STRIPE_COUPON_SETUP_WAIVER=      # 100%-off coupon restricted to the setup price
# PRICE_MONTHLY_DISPLAY=£19.99
# PRICE_SETUP_DISPLAY=£149.99
# SETUP_WAIVER_CODE_DISPLAY=WELCOME
# SETUP_FEE_PROMO=1                # 0 hides the setup-fee mechanic entirely (solicitor gate)
# PRICE_MONTHLY_PENCE=1999         # ops MRR arithmetic
# LEAD_ALERT_FROM_EMAIL=           # new-lead alert From: (verified Resend domain)
# BILLING_GRACE_DAYS=7             # past_due grace before the cron disables a site
# SITE_FLAGS_CACHE_TTL_MS=60000    # middleware noindex lookup cache (0 in e2e)

# ── Local dev knobs ──────────────────────────────────────────────────────────
# PGLITE_DIR=.pglite/dev
# PREVIEW_BASE_HOST=localhost
# OPERATOR_BRAND_NAME=Tradies Studio
# OPERATOR_LEGAL_NAME=Tradies Studio Ltd
# OPERATOR_CONTACT_EMAIL=privacy@tradies.co.uk
# PLAYWRIGHT_CHROMIUM_PATH=        # containers with a pinned chromium build
