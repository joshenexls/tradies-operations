# Everything runs offline by default (PGlite + fixtures + FixtureLLM).
# Add keys as they arrive — no code changes needed.

# ── Stage A (ops desk + Supabase + real Claude) ──────────────────────────────
# DATABASE_URL=                    # Supabase Postgres. Migrations need the
#                                  # SESSION-mode string (port 5432): DATABASE_URL=... pnpm --filter @tradies/db db:migrate
# SITE_GENERATOR=fixture           # fixture | anthropic
# ANTHROPIC_API_KEY=               # Anthropic Console (required when SITE_GENERATOR=anthropic)
# ANTHROPIC_MODEL=claude-sonnet-5
# LLM_RATE_INPUT_MICROGBP=2.4      # micro-GBP per input token (Sonnet 5 ≈ $3/MTok @ ~£0.79/USD)
# LLM_RATE_OUTPUT_MICROGBP=12
# OPS_AUTH_USER=ops                # ops desk Basic auth — MUST be set in prod
# OPS_AUTH_PASS=
# PREVIEW_URL_PATTERN=http://{slug}.localhost:3000   # prod: https://{slug}.app.tradies.co.uk
# LANGFUSE_PUBLIC_KEY=             # optional tracing
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=

# ── Stage B (orchestration + discovery) ──────────────────────────────────────
# TRIGGER_SECRET_KEY=              # Trigger.dev Cloud
# TRIGGER_PROJECT_ID=
# INTEGRATIONS=fixture             # fixture | real
# APIFY_TOKEN=                     # Apify console (Google Maps scraper actor)
# APIFY_ACTOR_ID=compass~crawler-google-places
# APIFY_COST_PER_PLACE_MICROGBP=2400
# FIRECRAWL_API_KEY=
# PAGESPEED_API_KEY=               # optional — PSI is keyless at low volume
# JUDGE_MODEL=claude-haiku-4-5
# JUDGE_RATE_INPUT_MICROGBP=0.8
# JUDGE_RATE_OUTPUT_MICROGBP=4
# OUTREACH_DRY_RUN=1               # keep 1 until Phase 5 (Smartlead)
# RENDER_QA_DIR=.qa-artifacts
# PREVIEW_TTL_DAYS=30

# ── Local dev knobs ──────────────────────────────────────────────────────────
# PGLITE_DIR=.pglite/dev
# PREVIEW_BASE_HOST=localhost
# OPERATOR_BRAND_NAME=Tradies Studio
# OPERATOR_LEGAL_NAME=Tradies Studio Ltd
# OPERATOR_CONTACT_EMAIL=privacy@tradies.co.uk
# PLAYWRIGHT_CHROMIUM_PATH=        # containers with a pinned chromium build
