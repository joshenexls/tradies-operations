{
  "extends": "@tradies/config/tsconfig/react.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] },
    "types": ["node", "react", "react-dom"],
    "allowJs": true,
    "incremental": true
  },
  "include": ["next-env.d.ts", "src/**/*", "scripts/**/*", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "tests"]
}
